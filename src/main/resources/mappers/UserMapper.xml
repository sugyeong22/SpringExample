<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.sudal.springexample.mvc.repository.UserRepository">

    <insert id="inserUser" parameterType="map">
        INSERT INTO `new_user`
        (
         `name`
            ,`yyyymmdd`
            ,`email`
            ,`introduce`
        )
        VALUE
        (
            #{name}
            ,#{birthday}
            ,#{email}
            ,#{introduce}
        )
    </insert>

    <insert id="insertUserByObject"
            parameterType="com.sudal.springexample.mvc.domian.User"
            useGeneratedKeys="true" keyProperty="id"> <!-- 객체의 프라이머리키를 바로 가져오고 싶다면 설정해야하는 옵션 -->
             <!-- parameterType 객체에 keyProperty의 값에 프라이머리 키를 넣어서 전달. -->
        INSERT INTO
            `new_user`
        (
          `name`
        , `yyyymmdd`
        , `email`
        , `introduce`
        )
            VALUE
            (
            #{name}
            , #{yyyymmdd}
            , #{email}
            , #{introduce}
            )
    </insert>

    <select id="selectLastUser"
            resultType="com.sudal.springexample.mvc.domian.User">
        SELECT
            `id`
             ,`name`
             ,`yyyymmdd`
             ,`email`
             ,`introduce`
            ,`created_at`
            ,`updated_at`
        FROM
            `new_user`
        ORDER BY
            `id` DESC
        LIMIT 1

    </select>

    <select id="selectCountByEmail" parameterType="String"
            resultType="int">
        SELECT
            COUNT(*)
        FROM
            `new_user`
        WHERE
            `email` = #{email}
    </select>
</mapper>